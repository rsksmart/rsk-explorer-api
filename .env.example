DATABASE_URL=
# The RSK node (one http or https URL) every process connects to. Falls back to a local default when unset.
RSK_NODE_URL=
# Enable the Bitcoin merge-mining stats cron jobs (ingest + daily snapshot). Off unless set to true.
BITCOIN_STATS_ENABLED=false
# Comma-separate multiple endpoints for failover, e.g. http://node-a:8332,http://node-b:8332
BITCOIN_RPC_URL=http://localhost:8332